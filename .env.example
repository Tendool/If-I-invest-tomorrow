# Copy to .env to override the defaults used by docker-compose.yml

# Ollama: default is the one running on your machine. For the bundled container use:
#   OLLAMA_HOST=http://ollama:11434   and start with   docker compose --profile ollama up
# OLLAMA_HOST=http://host.docker.internal:11434
# IFIT_LLM_MODEL=qwen3.5:4b

# Published ports
# WEB_PORT=3000
# API_PORT=8000

# The browser talks to the API directly: this must be reachable from the browser. Changing it needs --build.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# IFIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
